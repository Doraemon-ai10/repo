{
  "name": "rblx-server-finder-v2",
  "version": "4.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {"dev":"next dev","build":"next build","start":"next start","lint":"next lint","desktop:build":"next build && electron-builder --win nsis"},
  "dependencies": {"next":"latest","react":"latest","react-dom":"latest"},
  "devDependencies": {"typescript":"latest","@types/node":"latest","@types/react":"latest","@types/react-dom":"latest","electron":"^38.0.0","electron-builder":"^26.0.12"},
  "build": {
    "appId":"com.noobie.rblxfinder","productName":"RBLXFinder — Noobie Gaming Hub","publisherName":"Noobie",
    "files":["electron/**/*",".next/standalone/**/*","public/**/*","package.json"],"directories":{"output":"dist"},
    "win":{"target":[{"target":"nsis","arch":["x64"]}],"artifactName":"RBLXFinder-Noobie-Setup-${version}.${ext}"},
    "nsis":{"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"RBLXFinder — Noobie"}
  }
}
